<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve indexed legacy URLs while consolidating them onto clean routes.
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^shop\.html$ /shop [R=301,QSD,L]

  # 1. Route /api/* requests to api/index.php
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Serve a route-specific HTML head while retaining the clean public URL.
  RewriteRule ^(shop|men|women|perfumes|new-arrivals|stitching|about|contact|size-guide|shipping-policy|return-policy|privacy-policy|terms|cart|checkout|track-order)/?$ __seo/$1.html [L]
  RewriteRule ^men/(ahmad-cotton|rashid-cotton|wash-and-wear|boski|khaddar|lattha|karandi)/?$ __seo/men/$1.html [L]
  RewriteRule ^categories/(ahmad-cotton|rashid-cotton|wash-and-wear|boski|khaddar|lattha|karandi)/?$ __seo/categories/$1.html [L]
  RewriteRule ^product/([a-z0-9-]+)/?$ __seo/product/$1.html [L]

  # 2. Handle React Router dynamic URLs (redirect all non-file non-dir requests to index.html)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------
# 3. High-Performance CDN & Browser Caching Headers
# ----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Hashed Static Assets
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set CDN-Cache-Control "max-age=31536000"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # HTML Files Cache Control (Always revalidate for fresh updates)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------
# 4. Gzip / Deflate Compression
# ----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
